{
  "name": "signal-linkedin-feed-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Scores every LinkedIn post for relevance and information value, then filters noise and ads from your feed.",
  "homepage": "https://hithere-devs.github.io/signal-linkedin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hithere-devs/signal-linkedin.git"
  },
  "bugs": {
    "url": "https://github.com/hithere-devs/signal-linkedin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "npm run icons && node build.mjs",
    "dev": "npm run icons && node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "verify": "node scripts/verify-release.mjs",
    "check": "npm run typecheck && npm test && npm run audit",
    "package": "npm run check && npm run build && npm run verify && node scripts/package.mjs",
    "zip": "npm run package"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
