# Optional build-time defaults for the AI provider.
# These are baked into the bundle when you run `npm run build`.
# You can also configure everything at runtime in Settings > AI Provider
# (recommended: enter your API key there; it is stored only in chrome.storage.local).

# Optional examples. The settings page has the same presets.
# Free/private: Ollama at http://127.0.0.1:11434/v1 with llama3.2:3b
# Hosted free tiers: Groq, OpenRouter free models, or Google Gemini.
SIGNAL_AI_BASE_URL=http://127.0.0.1:11434/v1
SIGNAL_AI_MODEL=llama3.2:3b

# Prefer leaving this blank and entering the key in the extension settings UI.
SIGNAL_AI_API_KEY=

# Optional account sync. Create a Supabase project, apply the migration in
# supabase/migrations, then provide its public project URL and anon key.
# These values identify the project; row-level security protects user data.
SIGNAL_SUPABASE_URL=https://your-project.supabase.co
SIGNAL_SUPABASE_ANON_KEY=
